# Copy this file to config/payroll.env on the server. Do not commit that copy.
# The previous daily_sync.php stored a database password in source.
# Rotate that password, then put the new password here.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_payroll
DB_USER=payroll_user
DB_PASS=replace-with-rotated-password
