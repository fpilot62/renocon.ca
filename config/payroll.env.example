# Copy this file to config/payroll.env on the server. Do not commit that copy.
# The previous daily_sync.php stored a database password in source.
# Rotate that password, then put the new password here.

# Put the live copy OUTSIDE the web root, not in this folder.
# On the payroll server the default path is /home/renocon/private/payroll.env
# (two directories above this app). Or set PAYROLL_ENV_FILE to that absolute path.
# chmod 600 the file and chmod 700 the private directory.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_payroll
DB_USER=payroll_user
DB_PASS=replace-with-rotated-password

# 32-byte key, base64-encoded. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Used to encrypt bank accounts and SINs. Losing it makes those values unreadable.
PAYROLL_DATA_KEY=replace-with-random-key

# Set to 1 only when PHP does not see HTTPS and a trusted proxy terminates TLS.
# PAYROLL_TRUST_PROXY=1
# Set to 1 only for a local HTTP test. Leave unset on the server.
# PAYROLL_ALLOW_HTTP=1
